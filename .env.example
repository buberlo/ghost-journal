# Ghost Journal environment variables
#
# Copy this file to .env.local (or .env) for local development.
# Every variable is optional. With no variables set, Ghost Journal still works:
#   - SQLite database: ./data/ghost-journal.db
#   - AI counterpoints: built-in local generator

# OpenAI API key.
# Set to use OpenAI for counterpoints. Leave blank for the local fallback.
OPENAI_API_KEY=

# Optional OpenAI model. Useful for testing or cost control.
# OPENAI_MODEL=gpt-4o-mini

# Local SQLite database file path.
# Relative paths are resolved from the project root.
# Leave blank to use the default zero-setup path.
GHOST_JOURNAL_DB_PATH=

# Optional absolute base URL for share/export links.
# Leave blank to derive the URL from the incoming request.
NEXT_PUBLIC_BASE_URL=